POSTGRES_USER=finora
POSTGRES_PASSWORD=finora_dev_password
POSTGRES_DB=finora

# Local development addresses (your Mac). Docker overrides these inside containers.
DATABASE_URL=postgresql+psycopg://finora:finora_dev_password@localhost:5433/finora
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

LIMITFORGE_URL=http://localhost:8001
BUREAU_URL=http://localhost:8002
SERVICE_TIMEOUT_SECONDS=5

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@finora.dev
FRONTEND_URL=http://localhost:3000

SEED_DEMO=true